# Static origin for the mobile web build (apps/mobile, expo export --platform
# web, base URL = domain root). Internal only: the edge Caddy of the backend
# stack terminates TLS on book-eat.com and proxies mobile User-Agents here.

{
	admin off
	auto_https off
}

:3200 {
	root * /srv/mobile/current
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# Metro hashes every file under _expo/static: safe to cache forever.
	@immutable path /_expo/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The shell and the release marker must always be fetched fresh, otherwise
	# a browser keeps an index.html that points at bundles a later release
	# has pruned.
	@fresh path / /index.html /release.txt /metadata.json
	header @fresh Cache-Control "no-cache"

	# ADR-046: the SPA is never indexed; crawlers are sent to the desktop app
	# by the edge proxy, this is belt and braces.
	header X-Robots-Tag "noindex"

	# Single-page app (app.json: web.output = "single"): every route that is
	# not a file is index.html, expo-router takes it from there.
	try_files {path} /index.html
	file_server
}
