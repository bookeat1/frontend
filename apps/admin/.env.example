# Base URL of the BookEat backend the admin panel talks to (must include no
# trailing /api/v1 — the client appends /api/v1 paths itself is NOT the case:
# NEXT_PUBLIC_API_URL should point at the host+/api/v1 root).
#
# Test backend:
NEXT_PUBLIC_API_URL=https://test.backend.book-eat.com/api/v1

# Amplitude product analytics (autocapture + Session Replay).
#
# This is a client-side WRITE key: public by design — it is baked verbatim into
# the shipped JS bundle, exactly like NEXT_PUBLIC_API_URL, and only says which
# Amplitude project events land in. If absent, analytics silently no-op and the
# panel works unchanged. Read at BUILD time.
#
# Project bitter-recipe-077995:
NEXT_PUBLIC_AMPLITUDE_API_KEY=ea6dc484a21af0092fc13af158f8c404

# Web-push (browser notifications about new bookings).
#
# VAPID PUBLIC key — safe to expose (it is the public half; the private key
# lives only on the backend). Must match the backend's PUSH_VAPID_PUBLIC_KEY.
# If absent, the "Включить уведомления" control is hidden and nothing breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Base path the panel is served under, WITHOUT a trailing slash. Empty in dev
# (served at root), "/admin-preview" on the test static export.
#
# This is the ONLY place the prefix is set: next.config.mjs feeds it to
# `basePath`, and the app reads the same variable (src/lib/base-path.ts) for the
# things Next does not prefix by itself — the sign-in redirect after a dead
# session, and the service worker at "<basePath>/sw.js" with scope "<basePath>/".
# It is read at BUILD time, so it must be exported before `next build`, not
# supplied to the running container.
# NEXT_PUBLIC_BASE_PATH=/admin-preview
