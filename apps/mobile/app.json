{
  "expo": {
    "name": "BookEat",
    "slug": "bookeat-mobile",
    "scheme": "bookeat",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "./plugins/withAndroidBackupRules",
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#B33036"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BookEat покажет вашу галерею, чтобы вы выбрали фотографию профиля.",
          "cameraPermission": "BookEat откроет камеру, чтобы вы сняли фотографию профиля."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BookEat использует геопозицию, только пока приложение открыто, чтобы показать сначала ближайшие к вам заведения. Координаты не сохраняются.",
          "locationAlwaysAndWhenInUsePermission": "BookEat использует геопозицию, только пока приложение открыто, чтобы показать сначала ближайшие к вам заведения. Координаты не сохраняются.",
          "locationAlwaysPermission": "BookEat использует геопозицию, только пока приложение открыто, чтобы показать сначала ближайшие к вам заведения. Координаты не сохраняются.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookeatteam.bookeatapp",
      "buildNumber": "36",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:bookeat.godetour.link"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B33036",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bookeatteam.bookeatapp",
      "versionCode": 2,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bookeat.godetour.link",
              "pathPrefix": "/lQ9BPpUvJc"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "locales": {
      "kk": "./locales/kk.json",
      "en": "./locales/en.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "lang": "ru"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "455677ea-310b-4fa5-841f-676498838fd9"
      }
    },
    "owner": "book-eat-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/455677ea-310b-4fa5-841f-676498838fd9"
    }
  }
}
