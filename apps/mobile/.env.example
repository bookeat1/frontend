# Copy to .env to run the app against a real backend-core instance.
# Leave unset (or delete .env) to keep using the in-memory mock repository.
#
# Must include the /api/v1 prefix. Public test environment:
EXPO_PUBLIC_API_URL=https://test.backend.book-eat.com/api/v1

# Anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle and is therefore
# public — never put a token or a secret here.

# Set to 1 on an environment whose OTP delivery channels are NOT configured
# (no Telegram Gateway / WhatsApp / SMS credentials). The backend still answers
# {"sent":true} there — delivery degrades to otpsender.Stub, which sends
# nothing — so the sign-in screen says so instead of leaving the guest waiting
# for a code that will never arrive. Leave unset in production.
EXPO_PUBLIC_OTP_DELIVERY_DISABLED=1

# Amplitude product-analytics key (client-side WRITE key, public by design — it
# is inlined into the bundle exactly like EXPO_PUBLIC_API_URL and gates nothing
# on the server; it only routes events to the Amplitude project). Leave unset to
# run the app with analytics disabled — analytics.ts no-ops cleanly without it.
# The real build value is wired in eas.json (preview, beta*, production-main*
# profiles; scripts/check-eas-profiles.js enforces the key/server pairing);
# adding @amplitude/analytics-react-native is a NATIVE change, so it ships only
# on a fresh EAS build, never over OTA.
EXPO_PUBLIC_AMPLITUDE_API_KEY=ea6dc484a21af0092fc13af158f8c404

# Detour (deferred deep linking, Software Mansion, https://detour.swmansion.com)
# — SDK setup in src/lib/detour.ts, app/_layout.tsx (DetourProvider) and
# app/+native-intent.tsx. `apiKey` is the "publishable" client key Detour's
# own docs say is meant to ship inside the bundle — public by design, same as
# EXPO_PUBLIC_AMPLITUDE_API_KEY above. The SEPARATE secret key (server-side
# REST API for creating/listing links) must NEVER go in an EXPO_PUBLIC_ var —
# see ~/.bookeat/detour.env instead.
EXPO_PUBLIC_DETOUR_API_KEY=ecb953bd9c70db9c25b9c75719951fe40b7d27871bff8af49f40883f5196568f
# TODO(detour-app-id): product owner is still locating this in the Detour
# dashboard (2026-09-08). Leave unset until then — DetourProvider and
# +native-intent.tsx both fall back to a harmless no-op without it (see
# src/lib/detour.ts), nothing else in the app depends on it.
EXPO_PUBLIC_DETOUR_APP_ID=

# Base path baked into every asset/script URL by `expo export --platform web`
# (MW-3, ADR-046). NOT prefixed EXPO_PUBLIC_: app.config.js reads it while the
# export runs (Node), it never ships inside the client bundle. Leave unset to
# keep the default "/preview" (the test slot in Caddy,
# deploy/web-test/caddy-web-preview.snippet); the prod build will set this to
# whatever path/root the prod Caddy slot actually serves from.
BOOKEAT_WEB_BASE_URL=/preview
