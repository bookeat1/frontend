{
  "cli": {
    "version": ">= 21.5.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://test.backend.book-eat.com/api/v1",
        "EXPO_PUBLIC_OTP_DELIVERY_DISABLED": "1",
        "EXPO_PUBLIC_AMPLITUDE_API_KEY": "ea6dc484a21af0092fc13af158f8c404"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": false,
      "credentialsSource": "local",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://test.backend.book-eat.com/api/v1",
        "EXPO_PUBLIC_AMPLITUDE_API_KEY": "ea6dc484a21af0092fc13af158f8c404"
      },
      "channel": "production"
    }
  }
}
