# Адрес API для локальной разработки (`next dev`). Не секрет: это тот же
# публичный тестовый бэкенд, что прописан в apps/mobile/eas.json.
#
# Файл читается ТОЛЬКО в режиме разработки. Продакшн-сборка обязана получить
# NEXT_PUBLIC_API_URL из окружения — если его нет, сайт честно скажет «адрес
# сервера не задан» вместо того, чтобы молча пойти в тестовый контур.
NEXT_PUBLIC_API_URL=https://test.backend.book-eat.com/api/v1

# Known promo campaign UUIDs (backend migration 0107, 10.09.2026 onward) —
# checked by `campaign-attribution.ts`'s KNOWN_CAMPAIGN_IDS before a `?promo=`
# value is stored/sent as CreateBookingInput.promotionId. Not a secret, same
# reasoning as the API URL above. Comma-separated, any number of campaigns.
NEXT_PUBLIC_KNOWN_CAMPAIGN_IDS=6a3736b9-d4e5-4ec6-9ed2-7233476184fd,ab6cd665-eb11-4c45-b0ad-999db0c95116

# Legacy single-campaign var, still read and merged in for backward
# compatibility with already-deployed configs (see deploy-*.yml workflows).
# New campaigns go into NEXT_PUBLIC_KNOWN_CAMPAIGN_IDS above.
NEXT_PUBLIC_MARATHON_PROMO_ID=6a3736b9-d4e5-4ec6-9ed2-7233476184fd

# Amplitude — намеренно НЕ задан для локальной разработки: `analytics.ts`
# читает отсутствие ключа как «аналитика выключена» и работает без единого
# запроса к *.amplitude.com. Нужны события локально — положите стендовый
# ключ (тот же, что у `deploy-web-test.yml` / кабинета) в `.env.local`
# (в `.gitignore`), не сюда.
# NEXT_PUBLIC_AMPLITUDE_API_KEY=
